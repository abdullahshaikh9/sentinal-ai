APP_ENV=development
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/sentinel_ai
# Required for TiDB Cloud: absolute path to its CA PEM file. TLS verification remains enabled.
DATABASE_SSL_CA_PATH=
DATABASE_CONNECT_TIMEOUT_SECONDS=10
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
AI_PROVIDER=none
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=30
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_CHARS=5000
AI_REQUESTS_PER_MINUTE=10
# Optional Gemini integration: set AI_PROVIDER=gemini, GEMINI_API_KEY, and an AI_MODEL
# that is currently enabled for your Google AI API account. The key stays backend-only.
SESSION_TTL_MINUTES=60
# Keep false only for local HTTP development; production requires true and HTTPS.
AUTH_COOKIE_SECURE=false
OTP_PEPPER=replace-with-a-long-random-secret
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_RECIPIENT_PER_HOUR=3
OTP_MAX_SENDS_PER_IP_PER_HOUR=10
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15
# Set SMS_PROVIDER=textbee and TEXTBEE_ENABLED=true for TextBee SMS.
SMS_PROVIDER=console
# Keep disabled until a TextBee account, online Android device, and API key are configured.
TEXTBEE_ENABLED=false
TEXTBEE_API_KEY=
# Twilio credentials and sender are secrets/configuration kept in backend/.env only.
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=
SMS_TIMEOUT_SECONDS=10
# Disabled by default. Enable only temporarily with a high-entropy protected secret.
ADMIN_DIAGNOSTICS_ENABLED=false
ADMIN_DIAGNOSTIC_SECRET=
ADMIN_DIAGNOSTIC_CHALLENGE_TTL_SECONDS=60
ADMIN_DIAGNOSTIC_RATE_LIMIT=5
